datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  apiKeys    ApiKey[]
  endpoints  Endpoint[]
  events     Event[]
  deliveries Delivery[]

  @@map("tenants")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  keyHash   String    @unique @map("key_hash")
  prefix    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

enum EndpointStatus {
  active
  disabled
  circuit_open
}

model Endpoint {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  url        String
  secret     String
  eventTypes String[]       @default([]) @map("event_types")
  status     EndpointStatus @default(active)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]
  minuteStats EndpointStatsMinute[]

  @@map("endpoints")
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  type           String
  payload        Json
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@unique([tenantId, idempotencyKey])
  @@map("events")
}

enum DeliveryStatus {
  pending
  in_flight
  succeeded
  retrying
  dead
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  endpointId    String         @map("endpoint_id") @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0) @map("attempt_count")
  nextAttemptAt DateTime?      @map("next_attempt_at") @db.Timestamptz
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempts DeliveryAttempt[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  deliveryId      String   @map("delivery_id") @db.Uuid
  attemptNo       Int      @map("attempt_no")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz
  durationMs      Int      @map("duration_ms")
  responseStatus  Int?     @map("response_status")
  responseSnippet String?  @map("response_snippet")
  error           String?
  circuitSkipped  Boolean  @default(false) @map("circuit_skipped")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_attempts")
}

model EndpointStatsMinute {
  endpointId   String   @map("endpoint_id") @db.Uuid
  bucket       DateTime @db.Timestamptz
  attempts     Int      @default(0)
  successes    Int      @default(0)
  failures     Int      @default(0)
  latencySumMs BigInt   @default(0) @map("latency_sum_ms")
  latencyMaxMs Int      @default(0) @map("latency_max_ms")

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([endpointId, bucket])
  @@map("endpoint_stats_minute")
}

model KafkaProcessed {
  consumer  String
  topic     String
  partition Int
  offset    BigInt

  @@id([consumer, topic, partition, offset])
  @@map("kafka_processed")
}
